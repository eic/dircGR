time npsim --runType batch \
--compactFile $DETECTOR_PATH/epic_dirc_only.xml -G -N 20000000 \
--enableGun --printLevel WARNING \
--gun.multiplicity 1 --gun.particle "opticalphoton" --gun.energy 3.18*eV \
--gun.phiMin 0*deg --gun.phiMax 360*deg --gun.thetaMin 105*deg \
--gun.thetaMax 180*deg --gun.distribution "cos(theta)" --gun.position 766*mm,-158.175*mm,-2729*mm \
--part.userParticleHandler='' --outputFile ./LUT/lut_bar9_20M.edm4hep.root > bar9.out 2>&1

